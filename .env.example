# Firebase Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.web.app
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin (server only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# LLM / orchestration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Maps / Places / Routes
GOOGLE_MAPS_API_KEY=

# Events / activities (server only)
TICKETMASTER_API_KEY=

# Voice / phone layer
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CHANNEL=whatsapp
TWILIO_WEBHOOK_URL=https://congressapp-849ff.web.app/api/twilio/incoming
TWILIO_STATUS_CALLBACK_URL=https://congressapp-849ff.web.app/api/twilio/status

# Optional dedicated speech provider
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# App
WEB_ORIGIN=http://localhost:5173
API_PORT=3001
ALLOW_MOCKS=true

# Frontend API override. Leave blank in Firebase Hosting, which rewrites /api.
VITE_API_BASE_URL=

# Public Uber application identifier used only to construct ride handoff links.
VITE_UBER_CLIENT_ID=
